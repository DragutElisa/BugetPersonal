<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BugetPersonal.CheltuieliPage"
             Title="CheltuieliPage">
    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" Padding="10">
            <Label Text="Lista de cheltuieli" FontSize="24" FontAttributes="Bold" Grid.Row="0" Margin="0,0,0,10" />
            <RefreshView Grid.Row="1" x:Name="RefreshView" Command="{Binding LoadCheltuielisCommand}">
                <CollectionView x:Name="cheltuielisCollection" 
                          ItemsSource="{Binding Cheltuieli}"
                          SelectionMode="Single"
                          SelectionChanged="OnCheltuieliSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Icoana categoriei -->
                                <Image Grid.Column="0" Grid.RowSpan="2" 
                                   Source="{Binding CategoryIcon}"
                                   WidthRequest="40" HeightRequest="40"
                                   VerticalOptions="Center" Margin="0,0,10,0" />

                                <!-- Descriere și categorie -->
                                <Label Grid.Column="1" Grid.Row="0" Text="{Binding Description}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Grid.Row="1" Text="{Binding Category}" FontSize="Small" TextColor="Gray" />

                                <!-- Suma -->
                                <Label Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" 
                                   Text="{Binding Amount, StringFormat='{0:C}'}" 
                                   VerticalOptions="Center" HorizontalOptions="End" 
                                   FontAttributes="Bold" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            <Button Text="Adaugă cheltuială" Grid.Row="2" Clicked="OnAddCheltuieliClicked" />
        </Grid>
    </ScrollView>
</ContentPage>