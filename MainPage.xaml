<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BugetPersonal.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label
        Text="Bun venit, e timpul sa iti gestionezi bugetul!"
        FontSize="18"
        HorizontalOptions="Center"
        Margin="0,0,0,20"
        />
            <Frame CornerRadius="20"
           IsClippedToBounds="True"
           Padding="0"
           HasShadow="True"
           BorderColor="Transparent"
           HorizontalOptions="Center">
                <Image Source="bugetpersonal.jpg"
                  HeightRequest="200"
                  Aspect="AspectFit"/>
            </Frame>

            <Button
        Text="Cheltuieli"
        BackgroundColor="#6750A4"
        TextColor="White"
        CornerRadius="10"
        HeightRequest="50"
        Margin="0,10,0,0"
        Clicked="OnCheltuieliClicked" />

            <Button
        Text="Venituri"
        BackgroundColor="#6750A4"
        TextColor="White"
        CornerRadius="10"
        HeightRequest="50"
        Margin="0,10,0,0"
        Clicked="OnVenituriClicked" />



        </VerticalStackLayout>
    </ScrollView>

</ContentPage>