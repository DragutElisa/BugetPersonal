<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BugetPersonal.VenitDetailPage"
             Title="{Binding PageTitle}">
    <VerticalStackLayout Spacing="10" Padding="20">
        <Label Text="Descriere:" />
        <Entry Text="{Binding Venit.Description}" Placeholder="Descriere" />
        <Label Text="Sumă:" />
        <Entry Text="{Binding Venit.Amount}" Keyboard="Numeric" Placeholder="0.00" />
        <Label Text="Categorie:" />
        <Entry Text="{Binding Venit.Category}" Placeholder="Categoria venitului" />
        <Label Text="Data:" />
        <DatePicker Date="{Binding Venit.Date}" />
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
            <Button Text="Salvează" Clicked="OnSaveClicked" BackgroundColor="Green" TextColor="White" />
            <Button Text="Șterge" Clicked="OnDeleteClicked" BackgroundColor="Red" TextColor="White" 
                    IsVisible="{Binding IsExistingVenit}" />
            <Button Text="Anulează" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>